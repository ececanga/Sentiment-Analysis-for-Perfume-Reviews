digraph thesis_pipeline {
    graph [
        rankdir=TB,
        bgcolor="white",
        pad=0.22,
        nodesep=0.28,
        ranksep=0.38,
        splines=ortho,
        fontname="Arial"
    ];
    node [
        shape=box,
        style="rounded,filled",
        color="#334155",
        fillcolor="#F8FAFC",
        fontcolor="#111827",
        fontname="Arial",
        fontsize=14,
        margin="0.18,0.12",
        penwidth=1.5
    ];
    edge [color="#64748B", penwidth=1.4, arrowsize=0.75];

    A [label=<Review text sources<BR/><B>YouTube transcripts: benchmark</B><BR/>Synthetic reviews: extension>, fillcolor="#E8F1FF", color="#2563EB"];
    B [label=<Text preparation<BR/>cleaning · aggregation · provenance>, fillcolor="#E8F1FF", color="#2563EB"];
    D [label=<Feature extraction<BR/>NRC · VAD · transformer emotion signals>, fillcolor="#ECFDF5", color="#059669"];
    E [label=<Unified 58-feature<BR/>engineered matrix>, fillcolor="#ECFDF5", color="#059669"];
    F [label=<Gemini 3.1 Pro<BR/>browser-based structured annotation>, fillcolor="#F3E8FF", color="#7C3AED"];
    G [label=<Model-based reference labels<BR/>seven emotion targets>, fillcolor="#F3E8FF", color="#7C3AED"];
    H [label=<Supervised model roles<BR/><B>Main:</B> Logistic Regression<BR/><B>Comparisons:</B> XGBoost · BERT<BR/><B>Supplemental:</B> Random Forest · BiLSTM + Attention>, fillcolor="#FFF7ED", color="#EA580C"];
    I [label=<Evaluation<BR/>exact-source-grouped five-fold OOF<BR/>YouTube benchmark + weighted synthetic extension<BR/>fixed threshold 0.3>, fillcolor="#E0F2FE", color="#0284C7"];
    J [label=<Metrics and diagnostics<BR/>macro average precision · macro-F1 · macro ROC-AUC<BR/>paired source-component uncertainty>, fillcolor="#E0F2FE", color="#0284C7"];
    K [label=<Results, interpretation,<BR/>and bounded thesis conclusions>, fillcolor="#D1FAE5", color="#07877F"];

    A -> B;
    B -> D;
    D -> E;
    B -> F;
    F -> G;
    E -> H;
    G -> H;
    H -> I;
    I -> J;
    J -> K;

    {rank=same; D; F}
    {rank=same; E; G}
}
