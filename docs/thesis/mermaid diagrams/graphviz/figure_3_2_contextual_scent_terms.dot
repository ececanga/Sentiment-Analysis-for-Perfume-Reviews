digraph ContextTerms {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.24",
    nodesep="0.30",
    ranksep="0.44",
    splines=ortho,
    fontname="Arial",
    fontsize=24,
    fontcolor="#172033",
    labelloc="t",
    label="From YouTube Reviews to Writing Hints"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=17,
    fontcolor="#172033",
    penwidth=2.0,
    margin="0.20,0.14",
    width=5.6,
    height=0.82
  ];

  edge [color="#526A78", penwidth=2.0, arrowsize=0.75];

  review [
    label=<<B>1. YouTube perfume review</B><BR/><FONT POINT-SIZE="14">“This fragrance is uplifting with fresh citrus notes.”</FONT>>,
    fillcolor="#E8F2F7",
    color="#3155C6"
  ];

  match [
    label=<<B>2. Find feeling or perfume-description terms</B><BR/><FONT POINT-SIZE="14">Check each review word<BR/>Examples: uplifting • calming • mysterious • harsh</FONT>>,
    fillcolor="#FDECEC",
    color="#C9342F"
  ];

  nearby [
    label=<<B>3. Keep useful nearby words</B><BR/><FONT POINT-SIZE="14">Up to four words on each side → fresh • citrus • notes</FONT>>,
    fillcolor="#FFF5D9",
    color="#A97B18"
  ];

  repeat [
    label=<<B>4. Repeat for each perfume</B><BR/><FONT POINT-SIZE="14">Keep its most frequent nearby words</FONT>>,
    fillcolor="#EAF6ED",
    color="#3B7D4A"
  ];

  use [
    label=<<B>5. Context terms for<BR/>synthetic-review generation</B><BR/><FONT POINT-SIZE="14">Used to create synthetic reviews—not as classifier inputs</FONT>>,
    fillcolor="#FFF9DE",
    color="#C7A72A"
  ];

  review -> match -> nearby -> repeat -> use;
}
